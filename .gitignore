# Entorno virtual
venv/
.env/

# Archivos compilados de Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Archivos de logs y bases de datos locales
*.log
*.sqlite3

# Archivos de configuración de IDEs
.vscode/
.idea/

# Archivos de sistema (Windows / macOS)
Thumbs.db
.DS_Store

# Archivos grandes o comprimidos
*.zip
*.tar
*.gz

# Archivos de migraciones de Django (puedes decidir si ignorarlos o no)
*/migrations/__pycache__/
*/migrations/*.pyc

# Archivos de backup
*.bak
*.swp
*.zip

# Frontend (Vite + React en client/)
client/node_modules/
client/dist/
client/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Variables de entorno locales (mantener backend/.env vacío como referencia, ignorar sobrescrituras)
backend/.env.local
.claude/
